              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me"
              ]
            }
          }
        },
        {
          "name": "Ganti Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password\",\n  \"password\": \"password-baru\",\n  \"password_confirmation\": \"password-baru\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/me/password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "me",
                "password"
              ]
            }
          }
        },
        {
          "name": "Logout",
